# 環境變數範本 —— 2026-08-12 全面重寫
#
# 舊版這個檔案列的是 Telegram Bot（早已移除的推播管道），而真正必要的
# Supabase / Upstash / VAPID / 幣安金鑰一個都沒列到。實測代價：使用者照著
# 舊文件設定，live-runner 少了 VAPID 金鑰，於是「進場成交／TP1／出場」通知
# 全部靜默失敗，只有 Vercel 發的「新推薦單」通知會到——排查了兩輪才找到。
# 這份改成照「誰需要它」分區，缺哪個會怎樣寫清楚。
#
# ⚠️ 這只是範本。實際值放 .env.local（已被 .gitignore）或 Vercel 專案設定，
#    不要貼進 chat、不要 commit。

# ══════════════════════════════════════════════════════════════
# 【Vercel 與本機都需要】Supabase —— 資料庫
# ══════════════════════════════════════════════════════════════
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...        # 前端登入用
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # 伺服器端／live-runner 用，權限最高，絕不可外流

# ══════════════════════════════════════════════════════════════
# 【Vercel 與本機都需要】Web Push 推播金鑰
#
# ⚠️ 兩邊必須是「同一組」金鑰。換一組會讓手機上所有既有訂閱直接失效
#    （使用者要重新在設定頁開一次推播權限）。
# ⚠️ live-runner 沒設這兩個 → 進場/TP1/移動止損/出場/推薦單失效 全部收不到，
#    但「新推薦單」照樣會到（那是 Vercel 發的）。這就是「只收得到推薦單」
#    的典型症狀，不是推播機制壞掉。live-runner 啟動時會印警告。
#
# 產生新的一組（只有第一次建置時做，之後不要再重跑）：
#   npx web-push generate-vapid-keys
# ══════════════════════════════════════════════════════════════
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BN...
VAPID_PRIVATE_KEY=...
# Apple APNs 會嚴格驗這個 sub claim，必須是真實 mailto: 或 https://
# （example.com 這類 RFC 2606 保留網域會被 Apple 403 擋掉）。不設有預設值。
VAPID_SUBJECT=mailto:your@email.com

# ══════════════════════════════════════════════════════════════
# 【Vercel 與本機都需要】Upstash Redis —— 訊號鎖／熔斷／影子交易
#
# kill switch 是 Vercel 的 /api/analyze 跟 live-runner 共用的狀態，
# 兩邊必須指向同一個 Upstash 執行個體，否則其中一邊看不到開關。
# ══════════════════════════════════════════════════════════════
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# ══════════════════════════════════════════════════════════════
# 【只有 Vercel 需要】掃描 API 保護與調參
# ══════════════════════════════════════════════════════════════
# 外部 cron 打 /api/analyze 時要帶的密鑰（自己設任意字串）。
# 本機開發沒設的話 /api/analyze 可以直接打，方便測試。
WEBHOOK_SECRET=my-secret-key-123

# 掃描幣種（逗號分隔）。不設就用預設的成交量前 15 名。
# WATCH_COINS=BTCUSDT,ETHUSDT,SOLUSDT
# 分析時間週期。
# ANALYSIS_TIMEFRAMES=4h,1h
# 跨日權益回撤停機門檻（R）。預設 8，設 0 停用這道保護。
# MAX_DRAWDOWN_R=8

# ══════════════════════════════════════════════════════════════
# 【只有 live-runner（本機）需要】幣安 + 要監控誰
#
# ⚠️ live-runner 不會載入這個 .env 檔（專案沒裝 dotenv）——這些變數必須
#    設在「執行 npm run live-runner 的那個 shell 環境」裡，連同上面的
#    Supabase / VAPID / Upstash 三組也一樣。
# ══════════════════════════════════════════════════════════════
BINANCE_TESTNET_API_KEY=...
BINANCE_TESTNET_API_SECRET=...
# Supabase profiles.id（UUID）—— live-runner 只服務單一使用者，
# 不走登入流程，直接指定要監控誰的 trades。
TRADING_USER_ID=00000000-0000-0000-0000-000000000000
