# live-runner 的環境變數（systemd EnvironmentFile 格式：一行一個 KEY=VALUE，不要加 export、不要寫指令）。
# 複製成 /home/ubuntu/live-runner.env 並 chmod 600。值從 Vercel 專案設定與幣安 testnet 取得。
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRADING_USER_ID=
# Web Push：必須跟 Vercel 上同一組，否則手機既有訂閱會失效
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# 選用
# S3A_DRY_RUN=1                  # 只印不下單
# S3_MAX_DAILY_LOSS_USDT=        # 絕對金額硬閘（testnet 可不設，主網必設）
# S3_MAX_NOTIONAL_USDT=
